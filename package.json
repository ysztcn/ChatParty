{
  "name": "chat-party",
  "version": "1.0.4",
  "description": "一个同时与多个AI模型对话的桌面应用程序",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "prod": "node scripts/prod.js",
    "build:prod": "node scripts/build-prod.js",
    "dev:vite": "vite",
    "build": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder",
    "build:mac": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --mac --publish=never",
    "build:mac:arm64": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --mac --arm64 --publish=never",
    "build:mac:x64": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --mac --x64 --publish=never",
    "build:mac:universal": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --mac --universal --publish=never",
    "build:win": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --win --publish=never",
    "build:win:dir": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --win dir --publish=never",
    "build:win:portable": "node scripts/bump-version.js && node scripts/clean-dist.js && vite build && electron-builder --win portable --publish=never",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:pack": "node scripts/bump-version.js && node scripts/clean-dist.js && electron-builder",
    "clean": "node scripts/clean-cache.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src/"
  },
  "keywords": [
    "electron",
    "vue3",
    "typescript",
    "ai",
    "chat"
  ],
  "author": "月上中天",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.1",
    "terser": "^5.43.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.4.4",
    "marked": "^18.0.4",
    "pinia": "^2.1.7",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5"
  },
  "build": {
    "appId": "com.chatallai.app",
    "productName": "ChatParty",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDownload": {
      "cache": "./electron-cache"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "!node_modules/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!examples/**/*",
      "!.*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icons/chatparty-icon.png",
      "gatekeeperAssess": false,
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/chatparty-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "normal",
    "removePackageScripts": true,
    "asar": {
      "smartUnpack": false
    }
  }
}
